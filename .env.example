# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=auto
OPENROUTER_FALLBACK_MODELS=openrouter/free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=DarGlobal AI Assistant
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_TOKENS=900
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_RETRIES=1

# Backend
APP_NAME=DarGlobal AI Assistant
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
SCRAPE_RATE_LIMIT_SECONDS=1.0
SCRAPE_MAX_PAGES_PER_SITE=120
SCRAPE_TIMEOUT_SECONDS=25
SCRAPE_ADMIN_TOKEN=change-me
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_SCRAPE=2/hour

# RAG / Embeddings
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=backend/data/models
DATA_DIR=backend/data
STATIC_DIR=static
CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K_RESULTS=6
RAG_MIN_SCORE=0.3
RAG_MAX_CHUNKS_PER_URL=3
AUTO_BUILD_KB=true

# Frontend
VITE_API_BASE_URL=
